"""
Checks of a module whose objects are collections, on the Dang entrypoint
generated into it, driven through the CLI of the engine that runs them. The
engine serves keys, get, list and subset on a collection, from the markers the
module declares.
"""
type CollectionChecks {
  let fixturePath: String! = ".dagger/modules/e2e/fixtures/collections/shelf"
  let appName: String! = "shelf"
  let appPath: String! = ".dagger/modules/e2e/out/shelf"
  let playgroundRoot: String! = "/work"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  """
  The fixture module with its entrypoint: generated once to scaffold it, and
  again with the fixture's source in place of the template's, because the
  entrypoint holds the module's types.
  """
  let app(ws: Workspace!): Directory! {
    let scaffolded = javaSdk.generateScope(ws.withWorkdir(appPath), isModule: true, name: appName, clients: [])
    let withSource = scaffolded.withDirectory("/" + appPath, ws.directory("/" + fixturePath))
    javaSdk
      .generateScope(withSource.withWorkdir(appPath), isModule: true, name: appName, clients: [])
      .directory("/" + appPath)
  }

  """
  A container with the CLI of the engine's release, and a git workspace that
  holds the module at app/.
  """
  let playground(app: Directory!): Container! {
    container
      .from("registry.dagger.io/engine:" + (version.split("+")[0] ?? version))
      .withoutEntrypoint
      .withDirectory(playgroundRoot + "/app", app)
      .withWorkdir(playgroundRoot)
      .withExec(["git", "init", "--quiet"])
  }

  let cli(ctr: Container!, args: [String!]!): Container! {
    ctr.withExec(["dagger"] + args, experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
  }

  """
  Run a GraphQL query against the module and compare its answer, with the
  whitespace the CLI prints removed.
  """
  let assertQuery(pg: Container!, document: String!, want: String!): Void {
    let queried = pg.withExec(
      ["dagger", "-m", "app", "query"],
      stdin: document,
      experimentalPrivilegedNesting: true,
      expect: ReturnType.ANY,
    )
    let got = queried.stdout.replace(" ", "").replace("\n", "")
    assert(
      queried.exitCode == 0 and got == want,
      "the collections answered " + got + ", not " + want + "\n" + queried.stderr,
    )
  }

  """
  Call a function of the module and compare what it prints.
  """
  let assertCall(pg: Container!, args: [String!]!, want: String!): Void {
    let called = cli(pg, ["-m", "app", "call"] + args)
    let got = called.stdout.trimSpace
    assert(
      called.exitCode == 0 and got == want,
      "dagger call " + args.join(" ") + ": want " + JSON.encode(want) + ", got " + JSON.encode(got) +
        " (exit code " + JSON.encode(called.exitCode) + ")\n" + called.stderr,
    )
  }

  """
  The engine serves keys, list, get and subset on a collection whose members
  it finds by their markers, beside the collection's own functions, and fills
  the delta field with the keys added and removed since the module returned
  the collection.

  A collection that a function changes and returns keeps its base, so its
  delta compares it with the keys the module first returned. A new instance
  starts a base of its own, so its delta is empty, even when the receiver it
  came from had another base.
  """
  pub collectionCheck(ws: Workspace!): Void @check {
    assertQuery(playground(app(ws)), itemsQuery, itemsAnswer)
    null
  }

  let itemsQuery: String! = "{ items {\n" +
    "  keys\n" +
    "  list { name }\n" +
    "  get(key: \"a\") { name }\n" +
    "  selected removed\n" +
    "  subset(keys: [\"c\", \"b\"]) { keys selected removed }\n" +
    "  changed: change(names: [\"c\", \"d\"]) { keys added removed }\n" +
    "  fresh: subset(keys: [\"c\"]) { fresh { keys added removed } }\n" +
    "} }"

  """The answer to itemsQuery, with its keys sorted the way the CLI prints them."""
  let itemsAnswer: String! = "{\"items\":{" +
    "\"changed\":{\"added\":[\"d\"],\"keys\":[\"c\",\"d\"],\"removed\":[\"b\",\"a\"]}," +
    "\"fresh\":{\"fresh\":{\"added\":[],\"keys\":[\"z\"],\"removed\":[]}}," +
    "\"get\":{\"name\":\"item:a\"}," +
    "\"keys\":[\"b\",\"a\",\"c\"]," +
    "\"list\":[{\"name\":\"item:b\"},{\"name\":\"item:a\"},{\"name\":\"item:c\"}]," +
    "\"removed\":[]," +
    "\"selected\":[\"b\",\"a\",\"c\"]," +
    "\"subset\":{\"keys\":[\"b\",\"c\"],\"removed\":[\"a\"],\"selected\":[\"b\",\"c\"]}" +
    "}}"

  """
  Collections keyed by every type the engine takes: Int, Float, Boolean, an
  enum and the core scalar Platform. The delta names a removed key as text,
  whatever the key type. An item can be a collection itself.
  """
  pub collectionKeyTypesCheck(ws: Workspace!): Void @check {
    assertQuery(playground(app(ws)), kindsQuery, kindsAnswer)
    null
  }

  let kindsQuery: String! = "{\n" +
    "  numbers { keys get(key: 2) { name } subset(keys: [3, 1]) { keys removed } }\n" +
    "  ratios { keys get(key: 1.5) { name } subset(keys: [1.5]) { removed } }\n" +
    "  flags { keys get(key: false) { name } subset(keys: [false]) { removed } }\n" +
    "  colors { keys get(key: BLUE) { name } subset(keys: [BLUE]) { removed } }\n" +
    "  platforms { keys get(key: \"linux/arm64\") { name } subset(keys: [\"linux/arm64\"]) { removed } }\n" +
    "  racks { keys get(key: \"r2\") { keys get(key: \"r2-1\") { name } subset(keys: [\"r2-2\"]) { selected } } subset(keys: [\"r1\"]) { count } }\n" +
    "}"

  """The answer to kindsQuery, with its keys sorted the way the CLI prints them."""
  let kindsAnswer: String! = "{" +
    "\"colors\":{\"get\":{\"name\":\"blue\"},\"keys\":[\"RED\",\"BLUE\"],\"subset\":{\"removed\":[\"RED\"]}}," +
    "\"flags\":{\"get\":{\"name\":\"ffalse\"},\"keys\":[true,false],\"subset\":{\"removed\":[\"true\"]}}," +
    "\"numbers\":{\"get\":{\"name\":\"n2\"},\"keys\":[2,1,3],\"subset\":{\"keys\":[1,3],\"removed\":[\"2\"]}}," +
    "\"platforms\":{\"get\":{\"name\":\"linux/arm64\"},\"keys\":[\"linux/amd64\",\"linux/arm64\"],\"subset\":{\"removed\":[\"linux/amd64\"]}}," +
    "\"racks\":{\"get\":{\"get\":{\"name\":\"r2-1\"},\"keys\":[\"r2-1\",\"r2-2\"],\"subset\":{\"selected\":[\"r2-2\"]}},\"keys\":[\"r1\",\"r2\"],\"subset\":{\"count\":1}}," +
    "\"ratios\":{\"get\":{\"name\":\"r1.5\"},\"keys\":[0.5,1.5],\"subset\":{\"removed\":[\"0.5\"]}}" +
    "}"

  """
  The CLI names an item of a collection with a selector named after the module
  and the item type: after the collection, and in place of the path to it.
  subset selects several items for the collection's own functions.
  """
  pub collectionSelectorsCheck(ws: Workspace!): Void @check {
    let pg = playground(app(ws))
    assertCall(pg, ["items", "name", "--shelf-item=a"], "item:a")
    assertCall(pg, ["--shelf-item=c", "name"], "item:c")
    assertCall(pg, ["items", "subset", "--keys=c,b", "selected"], "b\nc")
    null
  }

  """
  `dagger check` runs an item's check once for each item its selectors name,
  and hands each the collection narrowed to those items: Item.verify takes
  its Items, and rejects item c. With -m, the selectors go in the check's
  link.
  """
  pub collectionItemCheck(ws: Workspace!): Void @check {
    let pg = playground(app(ws))
    let passed = cli(pg, ["-m", "app", "check", "items/verify?shelf-item=a&shelf-item=b"])
    assert(
      passed.exitCode == 0 and passed.stderr.contains("2 passed"),
      "the checks of a and b did not both pass:\n" + passed.stdout + passed.stderr,
    )
    let failed = cli(pg, ["-m", "app", "check", "items/verify?shelf-item=a&shelf-item=c"])
    let said = failed.stdout + failed.stderr
    assert(
      failed.exitCode != 0 and said.contains("1 passed") and said.contains("1 failed") and
        said.contains("verified a,c: c is rejected"),
      "the check of c did not fail alone, with the selected items in its error:\n" + said,
    )
    null
  }

  let itemsSourcePath: String! = "src/main/java/io/dagger/modules/shelf/Items.java"

  """
  A collection whose get method lacks @Function is refused when the module
  is generated, and a build that runs the processor prints an error that
  names the method and the missing annotation, where the engine would name
  neither (python-sdk#45).
  """
  pub collectionGetWithoutFunctionCheck(ws: Workspace!): Void @check {
    let generated = app(ws)
    let source = generated.file(itemsSourcePath).contents
    let bare = source.replace("  @Function\n  @Get\n", "  @Get\n")
    assert(bare != source, "Items.java has no @Function @Get method to strip")
    let broken = generated.withNewFile(itemsSourcePath, bare)

    let refused = javaSdk
      .generateScope(ws.withDirectory("/" + appPath, broken).withWorkdir(appPath), isModule: true, name: appName, clients: [])
      .cwd rescue { err: Error => "refused: " + err.message }
    assert(refused.hasPrefix("refused: "), "generation accepted a collection whose get method lacks @Function")

    let built = container
      .from("maven:3.9.9-eclipse-temurin-21-alpine@sha256:4cbb8bf76c46b97e028998f2486ed014759a8e932480431039bdb93dffe6813e")
      .withoutEntrypoint
      .withMountedCache("/root/.m2", cacheVolume("e2e-maven-m2"))
      .withDirectory("/module", broken, exclude: ["**/target/**"])
      .withWorkdir("/module")
      .withExec(["mvn", "compile", "-Ddagger.proc=full", "--no-transfer-progress"], expect: ReturnType.ANY)
    let want = "Method 'lookup' of 'Items' is marked @Get but not @Function. Add @Function: a collection's get function must be exposed."
    assert(
      built.exitCode != 0 and built.stdout.contains(want),
      "the build did not refuse the collection with " + JSON.encode(want) + ":\n" + built.stdout + built.stderr,
    )
    null
  }

  let checkoutRoot: String! = "/work/java-sdk"
  let callerFixturePath: String! = ".dagger/modules/e2e/fixtures/collections/shelf-caller"

  """
  This checkout in a container with the CLI of the engine's release, with the
  workspace config that registers it as the java SDK as its dagger.toml, and
  the generated fixture module at .dagger/modules/shelf.
  """
  let sdkPlayground(ws: Workspace!): Container! {
    container
      .from("registry.dagger.io/engine:" + (version.split("+")[0] ?? version))
      .withoutEntrypoint
      .withDirectory(
        checkoutRoot,
        ws.directory("/", exclude: [".git", "**/target/**"])
          .withFile("dagger.toml", ws.file("/.dagger/modules/e2e/workspace.toml")),
      )
      .withDirectory(checkoutRoot + "/.dagger/modules/shelf", app(ws))
      .withWorkdir(checkoutRoot)
      .withExec(["git", "init", "--quiet"])
  }

  let run(ctr: Container!, args: [String!]!): Container! {
    ctr.withExec(["dagger"] + args, experimentalPrivilegedNesting: true)
  }

  """
  A Java module calls the collections of the fixture module through the
  client generated from it: keys, list, get and subset, with keys of
  the types Int, an enum and Platform, and an item that is a collection.
  """
  pub collectionClientCheck(ws: Workspace!): Void @check {
    let callerPath = ".dagger/modules/shelf-caller"
    let initialized = run(sdkPlayground(ws), ["--auto-apply", "module", "init", "java", "--name", "shelf-caller", "--path", callerPath])
      .withDirectory(checkoutRoot + "/" + callerPath, ws.directory("/" + callerFixturePath))
    let ready = run(initialized.withWorkdir(callerPath), ["--auto-apply", "module", "client", "add", "../shelf", "--sdk", "java"])
      .withWorkdir(checkoutRoot)
    [
      ["report", "keys=[b, a, c] list=[item:b, item:a, item:c] get=item:a removed=[b, a]"],
      ["key-types", "number=n2 colors=[RED, BLUE] platform=linux/arm64 rack=[r2-1, r2-2]"],
    ].each { call =>
      let fn = call[0] ?? ""
      let want = call[1] ?? ""
      let called = cli(ready, ["-m", callerPath, "call", fn])
      let got = called.stdout.trimSpace
      assert(
        called.exitCode == 0 and got == want,
        "the caller's " + fn + ": want " + JSON.encode(want) + ", got " + JSON.encode(got) + "\n" + called.stderr,
      )
    }
    null
  }
}
