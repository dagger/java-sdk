"""
End-to-end checks for the Java SDK helper module.

Every check here calls the java-sdk module, which needs an engine at its floor,
v1.0.0-beta.18, or later. dagger.toml does not install this module, so
`dagger check` runs these checks only through `engine-e2e:floor-check`, on an
engine built from the floor's commit. AGENTS.md has the commands that run them
on the local engine.
"""
type E2e {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  # Scratch scopes, created in memory. generateScope always generates now, so
  # every scope a check drives has to be a module Maven can build, not a
  # config-only stub.
  let outputRoot: String! = ".dagger/modules/e2e/out"

  # The Java identifiers in nullableReturnSource, coreClientSource and
  # dagSource — package io.dagger.modules.newapp, class NewApp — and
  # newModuleSourcePath are derived from this name by hand and have to be
  # changed with it. Checks that just need *a* module reuse the
  # name so they share one vendored SDK build: the SDK jars are installed under
  # a per-module Maven version, so a second name costs a second build.
  let newModuleName: String! = "new-app"
  let newModulePath: String! = outputRoot + "/" + newModuleName
  let newModuleSourcePath: String! = "src/main/java/io/dagger/modules/newapp/NewApp.java"
  let clientAppName: String! = "client-app"
  let clientAppPath: String! = outputRoot + "/" + clientAppName

  let lookupModulePath: String! = fixtureRoot + "/lookup/app"
  let lookupNestedPath: String! = lookupModulePath + "/nested"
  # A module using a different SDK, with no pom.xml: never a Java client root.
  let nonJavaModulePath: String! = fixtureRoot + "/lookup/not-java"
  let clientDepPath: String! = fixtureRoot + "/clients/dep"

  # A git client, because a local module source carries no commit and so can
  # never show a pin, at an immutable tag so the commit asserted on cannot move.
  # It gets a module name of its own rather than sharing one: the dependency
  # gives the module a schema of its own, and the SDK jars are installed under a
  # per-module-name version, so a shared name would put two different SDK builds
  # on one Maven coordinate.
  let gitAppName: String! = "git-app"
  let gitAppPath: String! = outputRoot + "/" + gitAppName
  let gitClientRef: String! = "github.com/dagger/sdk-helpers@v1.0.2"
  let gitClientName: String! = "sdk-helpers"
  let gitClientPin: String! = "e5e38a5f0778c5a804931d95e5d0d9953668049a"

  # A client whose constructor arguments may all be omitted. Its own module name
  # for the same reason as gitAppName. The Java identifiers in
  # clientOptionalArgsSource are derived from this name by hand.
  let clientDefaultsPath: String! = fixtureRoot + "/clients/defaults"
  let defaultsAppName: String! = "defaults-app"
  let defaultsAppPath: String! = outputRoot + "/" + defaultsAppName

  let vendoredBindings: String! = "sdk/src/main/java/io/dagger/client/Dagger.java"
  let corePackagePath: String! = "clients/core/src/main/java/io/dagger/client/modules/core"
  let entrypointPath: String! = "src/generated/java/io/dagger/gen/entrypoint/Entrypoint.java"
  let dangEntrypointPath: String! = "src/generated/dang/entrypoint"

  """
  The manifest of a module with the Dang entrypoint: its name and the
  entrypoint only.
  """
  let entrypointManifest(name: String!): String! {
    "name = \"" + name + "\"\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./" + dangEntrypointPath + "\"\n"
  }

  let floorVersion: String! = "v1.0.0-beta.18"

  """
  Checks of a module generated with the Dang entrypoint, through the CLI.
  """
  entrypoint: EntrypointChecks! {
    EntrypointChecks()
  }

  """
  Fail the current check when a condition is false.
  """
  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) { raise message }
    null
  }

  """
  Return true when a list contains the exact string.
  """
  let contains(values: [String!]!, want: String!): Boolean! {
    values.filter { value => value == want }.length > 0
  }

  """
  Assert that a changeset added a path.
  """
  let assertAdded(changes: Changeset!, path: String!): Void {
    assert(contains(changes.addedPaths, path), "expected added path: " + path)
  }

  """
  Assert that a string contains a substring.
  """
  let assertContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want), message)
  }

  """
  Assert that a string contains every substring.
  """
  let assertContainsAll(value: String!, wants: [String!]!): Void {
    wants.each { want => assertContains(value, want, "expected to contain: " + want) }
    null
  }

  """
  Assert that a string does not contain a substring.
  """
  let assertNotContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want) == false, message)
  }

  """
  findClientRoot answers with the directory of the nearest pom.xml, as a path
  relative to the workspace root: the module itself from inside it, the owning
  module from a subdirectory, the owning module from inside its vendored SDK,
  and null where no pom.xml is in scope.
  """
  findClientRootCheck(ws: Workspace!): Void @check {
    assert(
      javaSdk.findClientRoot(ws.withWorkdir(lookupModulePath)) == lookupModulePath,
      "findClientRoot should answer with the module root itself",
    )
    assert(
      javaSdk.findClientRoot(ws.withWorkdir(lookupNestedPath)) == lookupModulePath,
      "findClientRoot should find the module owning a nested path",
    )

    # A module's vendored SDK has no pom.xml of its own, so the module answers
    # for it; nothing has to lift a hit out of sdk/ the way python-sdk does.
    let vendored = lookupModulePath + "/sdk/src/main/java"
    let withVendoredSdk = ws.withNewFile("/" + vendored + "/.keep", "")
    assert(
      javaSdk.findClientRoot(withVendoredSdk.withWorkdir(vendored)) == lookupModulePath,
      "findClientRoot should answer with the module owning a vendored sdk/",
    )

    assert(
      javaSdk.findClientRoot(ws.withWorkdir(nonJavaModulePath)) == null,
      "a module of another SDK, with no pom.xml, is not a Java client root",
    )
    assert(
      javaSdk.findClientRoot(ws.withWorkdir(".")) == null,
      "the workspace root is not a Java client root",
    )

    null
  }

  """
  generateScope initializes a scope that has no config: the template, a
  dagger-module.toml that names the Dang entrypoint and nothing else, the
  generated bindings, and both entrypoints, the Java one and the Dang one, all
  under the scope, with the workspace cwd and the files already there untouched.

  Generating the result again changes nothing, so generation is reproducible and
  a manifest that already says the right thing is not rewritten. A deleted
  generated entrypoint is generated again.
  """
  generateScopeInitCheck(ws: Workspace!): Void @check {
    let scoped = ws
      .withNewFile("/" + newModulePath + "/keep.txt", "keep\n")
      .withWorkdir(newModulePath)
    let generated = javaSdk.generateScope(scoped, isModule: true, name: newModuleName, clients: [])
    let changes = generated.withWorkdir(".").changes(scoped.withWorkdir("."))

    assert(generated.cwd == scoped.cwd, "generateScope must not change the workspace cwd")

    assertAdded(changes, newModulePath + "/dagger-module.toml")
    assert(
      contains(changes.addedPaths, newModulePath + "/dagger.json") == false,
      "initializing a scope must not write a dagger.json",
    )
    assertAdded(changes, newModulePath + "/pom.xml")
    assertAdded(changes, newModulePath + "/src/main/java/io/dagger/modules/newapp/NewApp.java")
    assertAdded(changes, newModulePath + "/" + vendoredBindings)
    assertAdded(changes, newModulePath + "/" + corePackagePath + "/Core.java")
    assertAdded(changes, newModulePath + "/" + entrypointPath)
    assertAdded(changes, newModulePath + "/" + dangEntrypointPath + "/main.dang")
    assertAdded(changes, newModulePath + "/" + dangEntrypointPath + "/build.dang")
    assert(
      changes.modifiedPaths.length == 0,
      "initializing a scope modified existing files: " + changes.modifiedPaths.join(", "),
    )
    assert(
      changes.removedPaths.length == 0,
      "initializing a scope removed existing files: " + changes.removedPaths.join(", "),
    )

    let manifest = changes.after.file(newModulePath + "/dagger-module.toml").contents
    assert(manifest == entrypointManifest(newModuleName), "the manifest is not the entrypoint manifest:\n" + manifest)
    assertContainsAll(changes.after.file(newModulePath + "/" + dangEntrypointPath + "/build.dang").contents, [
      "type JavaModuleBuild",
      "maven:3.9.9-eclipse-temurin-21-alpine@sha256:",
      "eclipse-temurin:21-jre-alpine-3.21@sha256:",
    ])
    assertContainsAll(changes.after.file(newModulePath + "/pom.xml").contents, [
      "<dagger.proc>none</dagger.proc>",
      "<artifactId>" + newModuleName + "</artifactId>",
    ])

    let again = javaSdk
      .generateScope(generated, isModule: true, name: newModuleName, clients: [])
      .withWorkdir(".")
      .changes(generated.withWorkdir("."))
    assert(again.isEmpty, "regenerating an unchanged module should change nothing")

    let recovered = javaSdk
      .generateScope(
        generated.withoutFile("/" + newModulePath + "/" + dangEntrypointPath + "/main.dang"),
        isModule: true,
        name: newModuleName,
        clients: [],
      )
      .withWorkdir(".")
      .changes(generated.withWorkdir("."))
    assert(recovered.isEmpty, "regenerating should restore a deleted generated entrypoint")

    null
  }

  """
  With dangEntrypoint = false, a new module names this repository's runtime and
  gets no Dang entrypoint.
  """
  generateScopeRuntimeCheck(ws: Workspace!): Void @check {
    let generated = javaSdk(dangEntrypoint: false)
      .generateScope(ws.withWorkdir(newModulePath), isModule: true, name: newModuleName, clients: [])
    assertContainsAll(generated.file("/" + newModulePath + "/dagger-module.toml").contents, [
      "name = \"" + newModuleName + "\"",
      "engineVersion = \"",
      "[runtime]",
      "source = \"github.com/dagger/java-sdk/runtime\"",
    ])
    assertNotContains(generated.file("/" + newModulePath + "/dagger-module.toml").contents, "[entrypoint]", "a module on the runtime got an entrypoint")
    assert(
      generated.directory("/" + newModulePath).exists(dangEntrypointPath) == false,
      "a module on the runtime got a Dang entrypoint",
    )
    null
  }

  """
  An existing module keeps the runtime it has until dangEntrypoint = true
  migrates it; a module on the entrypoint keeps it, and dangEntrypoint = false
  is refused for it rather than leaving a manifest that names a stale
  entrypoint. A module with the entrypoint refuses module clients and the
  manifest settings its manifest has no place for.
  """
  entrypointSelectionCheck(ws: Workspace!): Void @check {
    let manifestPath = "/" + newModulePath + "/dagger-module.toml"
    let onRuntime = javaSdk(dangEntrypoint: false)
      .generateScope(ws.withWorkdir(newModulePath), isModule: true, name: newModuleName, clients: [])
    let kept = javaSdk.generateScope(onRuntime, isModule: true, name: newModuleName, clients: [])
    assertContains(kept.file(manifestPath).contents, "[runtime]", "an existing module left its runtime without dangEntrypoint = true")

    let migrated = javaSdk(dangEntrypoint: true)
      .generateScope(onRuntime, isModule: true, name: newModuleName, clients: [])
    assert(
      migrated.file(manifestPath).contents == entrypointManifest(newModuleName),
      "dangEntrypoint = true did not migrate the module:\n" + migrated.file(manifestPath).contents,
    )
    let regenerated = javaSdk.generateScope(migrated, isModule: true, name: newModuleName, clients: [])
    assert(
      regenerated.withWorkdir(".").changes(migrated.withWorkdir(".")).isEmpty,
      "a module on the entrypoint did not stay on it",
    )

    let refused = javaSdk(dangEntrypoint: false)
      .generateScope(migrated, isModule: true, name: newModuleName, clients: [])
      .cwd rescue { err: Error => err.message }
    assertContains(refused, "set dangEntrypoint = true", "moving a module off its entrypoint was not refused: " + refused)

    let withClient = javaSdk
      .generateScope(migrated, isModule: true, name: newModuleName, clients: [ws.moduleSource("/" + clientDepPath)])
      .cwd rescue { err: Error => err.message }
    assertContains(withClient, "cannot use module clients yet", "a client of a module on the entrypoint was not refused: " + withClient)

    let included = onRuntime.withNewFile(manifestPath, onRuntime.file(manifestPath).contents.replace("[runtime]", "include = [\"../shared\"]\n\n[runtime]"))
    let withInclude = javaSdk(dangEntrypoint: true)
      .generateScope(included, isModule: true, name: newModuleName, clients: [])
      .cwd rescue { err: Error => err.message }
    assertContains(withInclude, "cannot carry (include)", "an include the entrypoint manifest drops was not refused: " + withInclude)

    null
  }

  """
  A pre-1.0 module is migrated: the contents of its dagger.json move into a
  dagger-module.toml, the runtime it already named is preserved rather than
  replaced by this SDK's own, and the dagger.json is removed so two manifest
  files cannot disagree.
  """
  generateScopeMigrateCheck(ws: Workspace!): Void @check {
    # Built from a generated module rather than a committed stub, because
    # generateScope always generates and so needs a module Maven can build. Same
    # module name as generateScopeInitCheck, so the vendored SDK build is shared.
    let scaffolded = javaSdk.generateScope(
      ws.withWorkdir(newModulePath),
      isModule: true,
      name: newModuleName,
      clients: [],
    )
    let legacy = scaffolded
      .withoutFile("/" + newModulePath + "/dagger-module.toml")
      .withNewFile(
        "/" + newModulePath + "/dagger.json",
        "{\n  \"name\": \"" + newModuleName + "\",\n"
          + "  \"engineVersion\": \"v1.0.0-0\",\n"
          + "  \"sdk\": {\n    \"source\": \"java\"\n  }\n}\n",
      )
    let migrated = javaSdk.generateScope(
      legacy.withWorkdir(newModulePath),
      isModule: true,
      name: newModuleName,
      clients: [],
    )
    let changes = migrated.withWorkdir(".").changes(legacy.withWorkdir("."))

    assertAdded(changes, newModulePath + "/dagger-module.toml")
    assert(
      contains(changes.removedPaths, newModulePath + "/dagger.json"),
      "migration should remove the pre-1.0 dagger.json",
    )
    assertContainsAll(migrated.file("/" + newModulePath + "/dagger-module.toml").contents, [
      "name = \"" + newModuleName + "\"",
      "source = \"java\"",
    ])

    null
  }

  """
  In a module scope the client set becomes the module's dependency set: the
  client is recorded in the manifest and its types reach the generated bindings,
  and a client that is no longer requested is dropped from both. A scope without
  a module is left alone, and standalone clients are refused rather than
  silently skipped.
  """
  generateScopeClientsCheck(ws: Workspace!): Void @check {
    let root = ws.withWorkdir(".")
    let scoped = ws.withWorkdir(clientAppPath)
    let manifestPath = clientAppPath + "/dagger-module.toml"
    let bindingsDir = clientAppPath + "/" + corePackagePath
    let client = ws.moduleSource("/" + clientDepPath)

    let untouched = javaSdk
      .generateScope(scoped, isModule: false, name: clientAppName, clients: [])
      .withWorkdir(".")
      .changes(root)
    assert(untouched.isEmpty, "a scope without a module should not be generated")

    let refused = javaSdk
      .generateScope(scoped, isModule: false, name: clientAppName, clients: [client])
      .cwd rescue "raised"
    assert(refused == "raised", "generateScope should refuse standalone clients")

    let withClient = javaSdk(dangEntrypoint: false).generateScope(scoped, isModule: true, name: clientAppName, clients: [client])
    assertContainsAll(withClient.file("/" + manifestPath).contents, [
      "[[dependencies]]",
      "name = \"client-dep\"",
      # A local client is recorded relative to the manifest, not to the
      # workspace root the SDK does its work from.
      "source = \"../../fixtures/clients/dep\"",
    ])
    assertNotContains(
      withClient.file("/" + manifestPath).contents,
      "pin =",
      "a client should not be pinned unless the SDK is locked",
    )

    # The payoff: because the client is recorded as a dependency, the module's
    # introspection schema carries its types and so do the generated bindings.
    let bindings = withClient.directory("/" + bindingsDir).entries
    assert(
      bindings.filter { entry => entry.contains("ClientDep") }.length > 0,
      "no ClientDep binding under " + bindingsDir + ", only: " + bindings.join(", "),
    )

    let withoutClient = javaSdk(dangEntrypoint: false).generateScope(withClient, isModule: true, name: clientAppName, clients: [])
    assertNotContains(
      withoutClient.file("/" + manifestPath).contents,
      "client-dep",
      "removing the last client should drop the dependency",
    )
    assert(
      withoutClient.directory("/" + bindingsDir).entries
        .filter { entry => entry.contains("ClientDep") }.length == 0,
      "removing the client should drop its types from the bindings",
    )

    null
  }

  """
  A client constructor argument a caller may omit — non-null with a default the
  engine fills in, or nullable — is bound as an optional argument, not as a
  parameter. The module source constructs the client with none of them and with
  all of them, and generation compiles it, so generating at all proves both
  calls are valid Java.
  """
  clientOptionalArgsCheck(ws: Workspace!): Void @check {
    let client = ws.moduleSource("/" + clientDefaultsPath)
    let scaffolded = javaSdk(dangEntrypoint: false).generateScope(
      ws.withWorkdir(defaultsAppPath),
      isModule: true,
      name: defaultsAppName,
      clients: [client],
    )
    let withSource = scaffolded.withNewFile(
      "/" + defaultsAppPath + "/src/main/java/io/dagger/modules/defaultsapp/DefaultsApp.java",
      clientOptionalArgsSource,
    )
    let bindings = javaSdk(dangEntrypoint: false)
      .generateScope(withSource, isModule: true, name: defaultsAppName, clients: [client])
      .file("/" + defaultsAppPath + "/" + corePackagePath + "/Core.java")
      .contents

    assertContainsAll(bindings, [
      "public ClientDefaults clientDefaults() {",
      "public ClientDefaults clientDefaults(ClientDefaultsArguments optArgs) {",
    ])
    assertNotContains(
      bindings,
      "clientDefaults(String name",
      "an argument with a default should not be a required parameter",
    )

    null
  }

  """
  A git client is recorded at the ref it was requested with, and the commit it
  resolved to is written as a pin only while the SDK is locked: generating
  unlocked leaves the dependency unpinned, and doing so again after a locked
  generation drops the pin that one recorded.
  """
  generateScopeLockCheck(ws: Workspace!): Void @check {
    let client = moduleSource(gitClientRef, refPin: gitClientPin)
    let scoped = ws.withWorkdir(gitAppPath)
    let manifestPath = "/" + gitAppPath + "/dagger-module.toml"

    let unlocked = javaSdk(dangEntrypoint: false).generateScope(scoped, isModule: true, name: gitAppName, clients: [client])
    assertContainsAll(unlocked.file(manifestPath).contents, [
      "name = \"" + gitClientName + "\"",
      "source = \"" + gitClientRef + "\"",
    ])
    assertNotContains(
      unlocked.file(manifestPath).contents,
      "pin =",
      "an unlocked generation should not pin a client",
    )

    let locked = javaSdk(lock: true, dangEntrypoint: false)
      .generateScope(unlocked, isModule: true, name: gitAppName, clients: [client])
    assertContains(
      locked.file(manifestPath).contents,
      "pin = \"" + gitClientPin + "\"",
      "a locked generation should record the commit the client resolved to",
    )

    let unlockedAgain = javaSdk(dangEntrypoint: false).generateScope(locked, isModule: true, name: gitAppName, clients: [client])
    assertNotContains(
      unlockedAgain.file(manifestPath).contents,
      "pin =",
      "generating unlocked again should drop the recorded pin",
    )

    null
  }

  """
  A module function returning Optional<Directory> should register an optional
  return type — and, since generation compiles the entrypoint it produces,
  generating at all proves the entrypoint the annotation processor writes for an
  Optional return is valid Java.
  """
  nullableReturnCheck(ws: Workspace!): Void @check {
    # Same scope and module name as generateScopeInitCheck, so both checks share
    # the vendored SDK build instead of each paying for one of their own.
    let scoped = ws.withWorkdir(newModulePath)
    let scaffolded = javaSdk.generateScope(scoped, isModule: true, name: newModuleName, clients: [])
    let withSource = scaffolded.withNewFile(
      "/" + newModulePath + "/src/main/java/io/dagger/modules/newapp/NewApp.java",
      nullableReturnSource,
    )
    let generated = javaSdk
      .generateScope(withSource, isModule: true, name: newModuleName, clients: [])
      .file("/" + newModulePath + "/" + entrypointPath)
      .contents

    assertContains(
      generated,
      "withObject(\"Directory\").withOptional(true)",
      "an Optional<Directory> return should register an optional Directory return type",
    )
    assertContains(
      generated,
      "res.orElse(null)",
      "the Optional return should be unwrapped before serialization",
    )

    null
  }

  """
  A module compiles against the core client package: core() over the session
  Dagger.dag() holds, core(session) over a session it names, and core types
  imported from io.dagger.client.modules.core. Generation writes core under
  clients/core and nothing under sdk/src/generated, the entrypoint the
  annotation processor writes enters core by name, and a plain Maven build of
  the module compiles. A pom.xml that still compiles sdk/src/generated/java is
  refused by name.
  """
  coreClientCheck(ws: Workspace!): Void @check {
    let scaffolded = javaSdk.generateScope(ws.withWorkdir(newModulePath), isModule: true, name: newModuleName, clients: [])
    let generated = javaSdk.generateScope(
      scaffolded.withNewFile("/" + newModulePath + "/" + newModuleSourcePath, coreClientSource),
      isModule: true,
      name: newModuleName,
      clients: [],
    )
    let module = generated.directory("/" + newModulePath)
    assert(module.exists(corePackagePath + "/Core.java"), "core was not generated under " + corePackagePath)
    assert(module.exists("sdk/src/generated") == false, "core was generated under sdk/src/generated too")
    assertContainsAll(module.file(entrypointPath).contents, [
      "import static io.dagger.client.modules.core.Core.core;",
      "core().module()",
    ])
    let built = mavenCompile(module)
    assert(built.exitCode == 0, "the module did not compile against the core client:\n" + built.stdout)

    let pomPath = "/" + newModulePath + "/pom.xml"
    let oldPom = generated.withNewFile(
      pomPath,
      generated.file(pomPath).contents.replace(
        "<source>clients/core/src/main/java</source>",
        "<source>sdk/src/generated/java</source>",
      ),
    )
    let refused = javaSdk
      .generateScope(oldPom, isModule: true, name: newModuleName, clients: [])
      .cwd rescue { err: Error => err.message }
    assertContains(
      refused,
      "pom.xml does not compile the core client",
      "a pom.xml without the core client source root was not refused: " + refused,
    )
    null
  }

  """
  Module code written against dag() as the core API does not compile, so the
  break shows when the module is built, not when a function runs:
  Dagger.dag() returns the Session, which has no container(), and the core
  types left io.dagger.client. Generation refuses the module, and a plain
  Maven build fails in the compiler with errors that name the missing method
  on the Session and the missing class.
  """
  dagRemovedCheck(ws: Workspace!): Void @check {
    let generated = javaSdk.generateScope(ws.withWorkdir(newModulePath), isModule: true, name: newModuleName, clients: [])
    let withDag = generated.withNewFile("/" + newModulePath + "/" + newModuleSourcePath, dagSource)
    let refused = javaSdk
      .generateScope(withDag, isModule: true, name: newModuleName, clients: [])
      .cwd rescue { err: Error => "refused: " + err.message }
    assert(refused.hasPrefix("refused: "), "generation accepted module code written against dag()")

    let built = mavenCompile(withDag.directory("/" + newModulePath))
    assert(built.exitCode != 0, "module code written against dag() compiled")
    assertContainsAll(built.stdout, [
      "COMPILATION ERROR",
      "cannot find symbol",
      "symbol:   method container()",
      "location: class io.dagger.client.Session",
      "symbol:   class Container",
      "location: package io.dagger.client",
    ])
    null
  }

  """
  A plain Maven compile of a generated module, as an IDE and the engine's
  build run it: the vendored SDK, the core client and the module's own code
  from source.
  """
  let mavenCompile(module: Directory!): Container! {
    container
      .from("maven:3.9.9-eclipse-temurin-21-alpine@sha256:4cbb8bf76c46b97e028998f2486ed014759a8e932480431039bdb93dffe6813e")
      .withoutEntrypoint
      .withMountedCache("/root/.m2", cacheVolume("e2e-maven-m2"))
      .withDirectory("/module", module, exclude: ["**/target/**"])
      .withWorkdir("/module")
      .withExec(["mvn", "compile", "--no-transfer-progress"], expect: ReturnType.ANY)
  }

  """
  floorCheck's precondition, not a check of its own: the engine running these
  checks is the floor release, by the version it reports itself. A release
  reports its build after a "+", which is not part of the version; a dev or
  later build is refused. engine-e2e's floorCheck calls it before the checks, so
  that check cannot pass on another engine.
  """
  assertFloorEngine: Void {
    if ((version.split("+")[0] ?? "") != floorVersion) {
      raise "the floor is " + floorVersion + " and the engine running these checks is " + version +
        ": a pass would not prove the floor. Run `dagger check engine-e2e:floor-check`, which provisions its engine"
    }
    null
  }

  """
  The SDK refuses an engine release older than its floor before it generates
  anything, and names the floor and the version it found. Every other version
  passes, a development build and one it cannot read among them, so an
  unexpected format never blocks a user. On an engine the SDK refuses,
  generation itself refuses; engine-e2e's belowFloorCheck runs this check on
  one.
  """
  engineFloorRefusalCheck(ws: Workspace!): Void @check {
    let refused = [
      "v1.0.0-beta.17", "v1.0.0-beta.17+0da36c8d", "v1.0.0-beta.11", "v1.0.0-beta.9",
      "v1.0.0-alpha.20", "v0.21.9",
    ]
    let accepted = [
      "v1.0.0-beta.18", "v1.0.0-beta.18+249edbd6", "v1.0.0-beta.19", "v1.0.0-rc.1", "v1.0.0",
      "v1.0.1", "v2.0.0-beta.1", "v0.21.1-20260529020034-dev-b2f595b50044", "v1.0.0-dev.3", "devel", "",
    ]
    refused.each { engine =>
      let refusal = javaSdk.engineRefusal(engine)
      let wants = ["needs Dagger engine " + floorVersion + " or later", "this engine is " + engine + ".", "Upgrade the engine"]
      wants.each { want =>
        assertContains(refusal, want, "engine \"" + engine + "\": the refusal does not say \"" + want + "\": " + refusal)
      }
    }
    accepted.each { engine =>
      let refusal = javaSdk.engineRefusal(engine)
      assert(refusal == "", "the SDK refused engine \"" + engine + "\": " + refusal)
    }
    let refusal = javaSdk.engineRefusal(version)
    if (refusal != "") {
      let said = javaSdk
        .generateScope(ws.withWorkdir(newModulePath), isModule: true, name: newModuleName, clients: [])
        .cwd rescue {
          err: Error => err.message
        }
      assert(said.contains(refusal), "generation on engine " + version + ", which the SDK refuses, said: " + said)
    }
    null
  }

  """
  A module that reaches core over the session Dagger.dag() holds and over a
  session it names, with a core type in its signature.
  """
  let coreClientSource: String! {
    "package io.dagger.modules.newapp;\n"
      + "\n"
      + "import static io.dagger.client.modules.core.Core.core;\n"
      + "\n"
      + "import io.dagger.client.Dagger;\n"
      + "import io.dagger.client.exception.DaggerQueryException;\n"
      + "import io.dagger.client.modules.core.Container;\n"
      + "import io.dagger.client.modules.core.Core;\n"
      + "import io.dagger.module.annotation.Function;\n"
      + "import io.dagger.module.annotation.Object;\n"
      + "import java.util.concurrent.ExecutionException;\n"
      + "\n"
      + "@Object\n"
      + "public class NewApp {\n"
      + "  @Function\n"
      + "  public Container base() {\n"
      + "    return core().container().from(\"alpine:3.22\");\n"
      + "  }\n"
      + "\n"
      + "  @Function\n"
      + "  public String release()\n"
      + "      throws ExecutionException, DaggerQueryException, InterruptedException {\n"
      + "    Core api = Core.core(Dagger.dag());\n"
      + "    return api.container().from(\"alpine:3.22\").file(\"/etc/alpine-release\").contents();\n"
      + "  }\n"
      + "}\n"
  }

  """
  A module written against dag() as the core API, with a core type imported
  from the package it left.
  """
  let dagSource: String! {
    "package io.dagger.modules.newapp;\n"
      + "\n"
      + "import static io.dagger.client.Dagger.dag;\n"
      + "\n"
      + "import io.dagger.client.Container;\n"
      + "import io.dagger.module.annotation.Function;\n"
      + "import io.dagger.module.annotation.Object;\n"
      + "\n"
      + "@Object\n"
      + "public class NewApp {\n"
      + "  @Function\n"
      + "  public Container base() {\n"
      + "    return dag().container().from(\"alpine:3.22\");\n"
      + "  }\n"
      + "}\n"
  }

  """A module whose only function returns a nullable object."""
  let nullableReturnSource: String! {
    "package io.dagger.modules.newapp;\n"
      + "\n"
      + "import static io.dagger.client.modules.core.Core.core;\n"
      + "\n"
      + "import io.dagger.client.modules.core.Directory;\n"
      + "import io.dagger.module.annotation.Function;\n"
      + "import io.dagger.module.annotation.Object;\n"
      + "import java.util.Optional;\n"
      + "\n"
      + "@Object\n"
      + "public class NewApp {\n"
      + "  @Function\n"
      + "  public Optional<Directory> maybeDirectory(boolean found) {\n"
      + "    if (!found) {\n"
      + "      return Optional.empty();\n"
      + "    }\n"
      + "    return Optional.of(core().directory().withNewFile(\"found\", \"\"));\n"
      + "  }\n"
      + "}\n"
  }

  """
  A module that constructs its client without the optional arguments and with
  all of them.
  """
  let clientOptionalArgsSource: String! {
    "package io.dagger.modules.defaultsapp;\n"
      + "\n"
      + "import static io.dagger.client.modules.core.Core.core;\n"
      + "\n"
      + "import io.dagger.client.exception.DaggerQueryException;\n"
      + "import io.dagger.client.modules.core.Core;\n"
      + "import io.dagger.module.annotation.Function;\n"
      + "import io.dagger.module.annotation.Object;\n"
      + "import java.util.concurrent.ExecutionException;\n"
      + "\n"
      + "@Object\n"
      + "public class DefaultsApp {\n"
      + "  @Function\n"
      + "  public String defaults()\n"
      + "      throws ExecutionException, DaggerQueryException, InterruptedException {\n"
      + "    return core().clientDefaults().greeting();\n"
      + "  }\n"
      + "\n"
      + "  @Function\n"
      + "  public String overridden()\n"
      + "      throws ExecutionException, DaggerQueryException, InterruptedException {\n"
      + "    return core()\n"
      + "        .clientDefaults(\n"
      + "            new Core.ClientDefaultsArguments().withName(\"java\").withTimes(2).withSuffix(\"!\"))\n"
      + "        .greeting();\n"
      + "  }\n"
      + "}\n"
  }
}
