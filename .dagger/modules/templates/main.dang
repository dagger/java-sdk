"""
Starter Dang module generated by dang-sdk.
"""
type Templates {
  let placeholder: String! = "<placeholder-list-templates>"
  let tmplFileName: String! = "main.dang.tmpl"
  let fileName: String! = "main.dang"

  """
  Render dang file with the current template list
  """
  pub generate(ws: Workspace!): Changeset! @generate {
    let src = ws.directory("/")
    src
      .withNewFile(
        fileName,
        src.file(tmplFileName).contents.replace(
          "<placeholder-list-templates>",
          src.directory("templates").entries.map { tmpl => tmpl.replace("/", "") }.join(", "),
        ),
      )
      .changes(src)
  }
}
